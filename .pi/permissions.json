{
  "outsideWorkspace": {
    "read": "allow",
    "list": "allow",
    "search": "allow",
    "write": "ask",
    "create": "ask",
    "rememberApprovals": "session"
  },
  "secrets": {
    "mode": "deny"
  },
  "bash": {
    "outsideWorkspaceFilesystem": "ask",
    "network": "ask",
    "safeCommands": [
      "git status *",
      "git diff *",
      "npm test *",
      "npm run typecheck",
      "git status --short *",
      "regex:^npm\\s+--prefix\\s+(?!/|~|\\.\\.(?:/|$)|.*\\/\\.\\.(?:/|$))[A-Za-z0-9._/@+-]+\\s+run\\s+typecheck$",
      "regex:^npm\\s+--prefix\\s+(?!/|~|\\.\\.(?:/|$)|.*\\/\\.\\.(?:/|$))[A-Za-z0-9._/@+-]+\\s+test\\s+--\\s+--run$"
    ]
  },
  "audit": {
    "enabled": true,
    "logAllowed": false,
    "logDenied": true,
    "logApprovals": true,
    "redactPaths": true
  }
}
